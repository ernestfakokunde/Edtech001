# Neon / Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

PORT=4000
# Public origin(s) of the app, comma-separated when there is more than one,
# e.g. "https://app.example.com,https://www.app.example.com". CORS rejects any
# browser origin that is not listed here (localhost:5173 is always allowed).
FRONTEND_ORIGIN="http://localhost:5173"
# Session/CSRF cookie policy: "lax" (default) when the app and this API share a
# registrable domain; "none" when the app is hosted on a different site (e.g.
# Vercel → Render), otherwise the browser drops the cookies and sign-in fails.
# "none" requires HTTPS, which Render provides.
#COOKIE_SAME_SITE="none"
SESSION_SECRET="replace-with-a-long-random-value"

# Supabase Storage only. Keep the service role key on the backend.
SUPABASE_URL="https://dkgkreykpjorrszikwum.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_BUCKET="recapp-paper"

# AI generation for POST /api/generation.
# Generation is provider-agnostic: configure ANY combination of API keys below.
# AI_PROVIDER          → the default (primary) provider for requests that do not
#                        pick one explicitly. One of: anthropic, openai, grok,
#                        gemini, custom.
# AI_FALLBACK_PROVIDERS→ comma-separated providers tried in order when the
#                        primary fails or returns an unusable answer. Example:
#                        "openai,gemini,grok".
AI_PROVIDER="anthropic"
AI_FALLBACK_PROVIDERS=""

# Anthropic (https://console.anthropic.com). Model can be any current model id;
# claude-sonnet-4-5 is the default.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-5"

# OpenAI (https://platform.openai.com/api-keys). Chat Completions API.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# Optional base URL override (e.g. an OpenAI-compatible proxy).
OPENAI_BASE_URL=""

# Grok by xAI (https://console.x.ai). Serves the same Chat Completions API as
# OpenAI, so GROK_BASE_URL can be pointed at a compatible endpoint too.
GROK_API_KEY=""
GROK_MODEL="grok-3"
GROK_BASE_URL=""

# Google Gemini (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Lighter sibling models tried automatically when the primary model is
# overloaded or missing for this key. Leave unset for the default
# "gemini-2.5-flash-lite,gemini-2.0-flash", or set to an empty value to disable.
#GEMINI_FALLBACK_MODELS="gemini-2.5-flash-lite,gemini-2.0-flash"

# Generic OpenAI-compatible provider for anything else (DeepSeek, Mistral,
# OpenRouter, LM Studio, Ollama, ...). Both the base URL and API key are
# required before this provider is considered configured.
CUSTOM_OPENAI_PROVIDER_NAME=""
CUSTOM_OPENAI_BASE_URL=""
CUSTOM_OPENAI_API_KEY=""
CUSTOM_OPENAI_MODEL="gpt-3.5-turbo"
