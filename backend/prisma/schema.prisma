generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaperVisibility {
  PRIVATE
  PUBLIC
}

enum PaperStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum Semester {
  FIRST
  SECOND
}

enum GeneratedSetType {
  QUIZ
  FLASHCARD
}

enum AccountTier {
  FREE
  PREMIUM
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

model Profile {
  id               String      @id @default(cuid())
  email            String      @unique
  passwordHash     String
  displayName      String?
  username         String?     @unique
  isAdmin          Boolean     @default(false)
  tier             AccountTier @default(FREE)
  xp               Int         @default(0)
  premiumUntil     DateTime?
  referralCode     String?     @unique
  referredById     String?
  suspendedUntil   DateTime?
  suspensionReason String?
  universityId     String?
  facultyId        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  university University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  referredBy Profile?             @relation("Referral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  Profile[]            @relation("Referral")
  claims     UserClaimedMission[]

  redeemedCodes     CodeRedemption[] @relation("CodeRedemptions")
  createdPromoCodes PromoCode[]      @relation("PromoCodeCreator")

  papers        Paper[]
  generatedSets GeneratedSet[]
  quizAttempts  QuizAttempt[]
  auditEvents   AuditEvent[]
  sessions      Session[]
  savedCourses  ProfileCourse[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  profileId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([expiresAt])
}

model University {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculties Faculty[]
  profiles  Profile[]
}

model Faculty {
  id           String   @id @default(cuid())
  universityId String
  name         String
  slug         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university  University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments Department[]
  profiles    Profile[]

  @@unique([universityId, slug])
}

model Department {
  id        String   @id @default(cuid())
  facultyId String
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([facultyId, slug])
}

model Course {
  id               String   @id @default(cuid())
  departmentId     String
  code             String
  title            String
  crossListingCode String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  department    Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  papers        Paper[]
  generatedSets GeneratedSet[]
  savedBy       ProfileCourse[]

  @@unique([departmentId, code])
  @@index([crossListingCode])
}

/// Courses a student saved on their profile for quick personal uploads and
/// generation. The link is user-scoped (max 10 enforced in the controller);
/// removing it never deletes the shared Course entity itself.
model ProfileCourse {
  profileId String
  courseId  String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([profileId, courseId])
  @@index([courseId])
}

model Paper {
  id          String          @id @default(cuid())
  ownerId     String
  courseId    String
  description String?
  level       String?
  session     String?
  year        Int?
  semester    Semester?
  fileUrl     String
  isPersonal  Boolean         @default(false)
  visibility  PaperVisibility @default(PRIVATE)
  status      PaperStatus     @default(DRAFT)
  extractedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner     Profile    @relation(fields: [ownerId], references: [id])
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([courseId, status, visibility])
  @@index([ownerId])
}

model Question {
  id          String   @id @default(cuid())
  paperId     String
  questionNo  String?
  prompt      String
  answer      String?
  explanation String?
  metadata    Json?
  createdAt   DateTime @default(now())

  paper    Paper              @relation(fields: [paperId], references: [id], onDelete: Cascade)
  setItems GeneratedSetItem[]

  @@index([paperId])
}

model GeneratedSet {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  type            GeneratedSetType
  title           String
  requestedLength Int
  timePerQuestion Int?
  createdAt       DateTime         @default(now())

  user     Profile            @relation(fields: [userId], references: [id])
  course   Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items    GeneratedSetItem[]
  attempts QuizAttempt[]

  @@index([userId, courseId])
  @@index([userId, createdAt])
}

model GeneratedSetItem {
  setId      String
  questionId String
  position   Int

  set      GeneratedSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([setId, questionId])
  @@unique([setId, position])
}

/// One finished quiz run. Stored so the student can open a "past results"
/// history page even after refresh / on another device. Score + total are
/// kept alongside the percentage for flexible display; answers detail stays
/// client-side only.
model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  setId     String
  score     Int
  total     Int
  percent   Int
  createdAt DateTime @default(now())

  user Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  set  GeneratedSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([setId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// A challenge the main admin creates (title, description, XP reward). Students
/// claim active missions once each and the XP lands on their profile — points
/// fuel the FREE → PREMIUM roadmap later.
model Mission {
  id          String   @id @default(cuid())
  title       String
  description String?
  xpReward    Int      @default(10)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  claims UserClaimedMission[]
}

model UserClaimedMission {
  profileId String
  missionId String
  claimedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@id([profileId, missionId])
  @@index([missionId])
}

model studySet {
  id        String   @id @default(cuid())
  title     String
  type      String
  createdAt DateTime @default(now())
}

/// A shareable code the admin creates ("free Pro for a week", XP bonuses, …).
/// Students redeem it once on their profile; premiumDays extends premiumUntil
/// (stacking from the later of now / their current expiry), xpBonus lands
/// immediately. Uses + expiry are optional caps the admin controls.
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  premiumDays    Int       @default(0)
  xpBonus        Int       @default(0)
  maxRedemptions Int?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy   Profile?         @relation("PromoCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions CodeRedemption[]

  @@index([isActive])
}

/// One student redeeming one promo code (unique pair = once per code each).
model CodeRedemption {
  id        String   @id @default(cuid())
  codeId    String
  profileId String
  createdAt DateTime @default(now())

  code    PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  profile Profile   @relation("CodeRedemptions", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([codeId, profileId])
  @@index([profileId])
}
