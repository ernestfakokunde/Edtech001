# Copy to `.env.local` (git-ignored) for local overrides.
# `.env.production` is committed and already points production builds at the
# deployed API, so this file is only a reference.

# Origin of the API used by built bundles. Must include the scheme
# (http:// or https://) and must not end with a slash.
VITE_API_URL=https://reacappedu.onrender.com

# Dev-server only. Where the Vite proxy sends /api requests.
# Set in the shell, e.g. VITE_PROXY_TARGET=https://reacappedu.onrender.com npm run dev
# to develop against the deployed API instead of the local one.
VITE_PROXY_TARGET=http://localhost:4000
