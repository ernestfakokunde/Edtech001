# Baked into the bundle by Vite for every production build (`vite build`).
# The deployed Render service — scheme included, no trailing slash.
# A real VITE_API_URL in the build environment (Vercel/Netlify/CI) wins over
# this file, so a different deployment only needs its own variable.
VITE_API_URL=https://reacappedu.onrender.com
